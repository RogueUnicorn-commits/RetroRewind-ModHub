   <Border x:Name="PosterBrowserSelectedPanel" Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="14" Margin="0,0,0,10" Visibility="Collapsed" MaxHeight="0" Opacity="0" ClipToBounds="True">
