     <TextBlock Grid.Row="1" Text="Installed .MP4 files" Margin="0,14,0,7" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}"/>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="VideosLibraryPanel"/>
     </ScrollViewer>
     <Grid Grid.Row="3" Margin="0,12,0,0">
      <TextBlock x:Name="VideosFolderText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis"/>
     </Grid>
    </Grid>
   </Border>

   <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0">
      <TextBlock Text="Video Slots (Game Movies)" FontWeight="SemiBold" FontSize="18"/>
