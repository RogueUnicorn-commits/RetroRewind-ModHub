 <Grid x:Name="SaveGrid" Grid.Row="2" Grid.Column="1">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="48"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

