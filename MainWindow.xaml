    <TextBlock x:Name="RequiredFilesOverallStatus" Text="" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>

 <Grid x:Name="VideoEditorGrid" Grid.Row="2" Grid.Column="1" Visibility="Collapsed" AllowDrop="True" PreviewDrop="VideoEditorGrid_Drop" PreviewDragOver="VideoEditorGrid_DragOver">
  <Grid Margin="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="Video Editor" FontWeight="SemiBold" FontSize="20"/>
      <TextBlock Text="Prepare MP4s for Retro Rewind and preview the CRT / VHS treatment before converting." Margin="0,4,0,14" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
     </StackPanel>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="42"/>
       <ColumnDefinition Width="42"/>
       <ColumnDefinition Width="8"/>
       <ColumnDefinition Width="*" MinWidth="0"/>
       <ColumnDefinition Width="8"/>
       <ColumnDefinition Width="42"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="VideoEditorBrowseButton" Grid.Column="0" ToolTip="Choose MP4" AutomationProperties.Name="Choose MP4" Style="{DynamicResource VideoEditorIconButtonStyle}" Click="VideoEditorBrowseButton_Click">
       <Border Width="22" Height="22" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
        <Border.OpacityMask><ImageBrush ImageSource="/RetroRewindModhub;component/Assets/VideoEditorChooseMp4.png" Stretch="Uniform"/></Border.OpacityMask>
       </Border>
      </Button>
      <Button x:Name="VideoEditorDownloadsButton" Grid.Column="1" ToolTip="Downloaded videos" AutomationProperties.Name="Downloaded videos" Style="{DynamicResource VideoEditorIconButtonStyle}" Click="VideoEditorDownloadsButton_Click">
       <Border Width="22" Height="22" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
        <Border.OpacityMask><ImageBrush ImageSource="/RetroRewindModhub;component/Assets/OpenVideo.png" Stretch="Uniform"/></Border.OpacityMask>
       </Border>
      </Button>
      <TextBox x:Name="VideoEditorUrlTextBox" Grid.Column="3" Height="36" MinWidth="0" VerticalAlignment="Center" VerticalContentAlignment="Center" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Style="{DynamicResource VideoEditorUrlInputStyle}" ToolTip="Paste a supported video URL"/>
      <Button x:Name="VideoEditorUrlButton" Grid.Column="5" ToolTip="Download URL" AutomationProperties.Name="Download URL" Style="{DynamicResource VideoEditorIconButtonStyle}" Click="VideoEditorUrlButton_Click">
       <Border Width="22" Height="22" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
        <Border.OpacityMask><ImageBrush ImageSource="/RetroRewindModhub;component/Assets/VideoEditorDownload.png" Stretch="Uniform"/></Border.OpacityMask>
       </Border>
      </Button>
     </Grid>
     <Border x:Name="VideoEditorDownloadProgressBorder" Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ProgressBar x:Name="VideoEditorDownloadProgressBar" Grid.Row="0" Height="8" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"/>
       <TextBlock x:Name="VideoEditorDownloadProgressText" Grid.Row="1" Margin="0,7,0,0" Text="Downloaded 0 MB | Total 0 MB | 0 MB/s" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/>
      </Grid>
     </Border>
     <Grid Grid.Row="3" Margin="0,14,0,14" ClipToBounds="False">
      <Border x:Name="VideoEditorDropBorder" Padding="18" AllowDrop="True"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
              PreviewDrop="VideoEditorGrid_Drop" PreviewDragOver="VideoEditorGrid_DragOver">
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="DROP MP4 HERE" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="VideoEditorInputText" Text="No video selected" Foreground="{DynamicResource SecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
       </StackPanel>
      </Border>
      <Border x:Name="VideoEditorPreviewBorder" Visibility="Collapsed" Background="Black" BorderThickness="0" CornerRadius="0" ClipToBounds="True">
        <Grid>
         <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <Grid Grid.Row="0">
          <ContentControl x:Name="VideoEditorPreviewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
         </Grid>
         <Border Grid.Row="1" Padding="8,7" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
           </Grid.ColumnDefinitions>
           <Button x:Name="VideoEditorPlayButton" Grid.Column="0" ToolTip="Play" AutomationProperties.Name="Play" Width="42" Height="30" Margin="0,0,6,0" Style="{DynamicResource VideoEditorIconButtonStyle}" Click="VideoEditorPlayButton_Click">
            <Grid Width="18" Height="18">
             <Border x:Name="VideoEditorPlayIcon" Width="18" Height="18" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
              <Border.OpacityMask><ImageBrush ImageSource="/RetroRewindModhub;component/Assets/VideoEditorPlay.png" Stretch="Uniform"/></Border.OpacityMask>
             </Border>
             <Border x:Name="VideoEditorPauseIcon" Width="18" Height="18" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="Collapsed">
              <Border.OpacityMask><ImageBrush ImageSource="/RetroRewindModhub;component/Assets/VideoEditorPause.png" Stretch="Uniform"/></Border.OpacityMask>
             </Border>
            </Grid>
           </Button>
<Button x:Name="VideoEditorStopButton" Grid.Column="1" ToolTip="Stop" AutomationProperties.Name="Stop" Width="42" Height="30" Margin="0,0,10,0" Style="{DynamicResource VideoEditorIconButtonStyle}" Click="VideoEditorStopButton_Click">
            <Border Width="18" Height="18" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
             <Border.OpacityMask><ImageBrush ImageSource="/RetroRewindModhub;component/Assets/VideoEditorStop.png" Stretch="Uniform"/></Border.OpacityMask>
            </Border>
           </Button>
           <Slider x:Name="VideoEditorTimelineSlider" Style="{DynamicResource VideoEditorSliderStyle}" Grid.Column="3" Minimum="0" Maximum="1" Value="0" Height="28" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="VideoEditorTimeline_Changed"/>
           <TextBlock x:Name="VideoEditorTimelineText" Grid.Column="4" Text="00:00 / 00:00" MinWidth="90" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}"/>
          </Grid>
         </Border>
        </Grid>
       </Border>
      </Grid>
     <StackPanel Grid.Row="4">
      <TextBlock x:Name="VideoEditorOutputText" Text="Live preview • NVIDIA CUDA/NVDEC • NVENC export" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
      <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <Button x:Name="VideoEditorClearButton" Grid.Column="0" Content="Unload Video" Visibility="Collapsed" MinWidth="120" Height="34" Margin="0,0,8,0" Style="{DynamicResource BrowseButtonStyle}" Click="VideoEditorClearButton_Click"/>
       <Button x:Name="VideoEditorConvertButton" Grid.Column="1" Content="Convert &amp; Add to Videos" Height="34" MinWidth="180" Style="{DynamicResource AccentButtonStyle}" Click="VideoEditorConvertButton_Click" IsEnabled="False"/>
       <CheckBox x:Name="VideoEditorPlayAudioCheckBox" Grid.Column="2" Content="Play Audio" Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="VideoEditorPlayAudio_Changed" Unchecked="VideoEditorPlayAudio_Changed"/>
      </Grid>
     </StackPanel>
    </Grid>
   </Border>

   <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="CRT / VHS Effect" FontWeight="SemiBold" FontSize="20"/>
      <TextBlock Text="The preview updates while you change the effect settings. The final conversion uses the same effect profile." Margin="0,4,0,14" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
     </StackPanel>
     <Grid Grid.Row="2" Grid.RowSpan="2" Margin="0,0,0,8">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,10">
       <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,6,0">
         <TextBlock Text="Crop Mode" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
         <ComboBox x:Name="VideoEditorCropModeComboBox"
                   SelectedValuePath="Tag"
                   Style="{DynamicResource SettingsComboBoxStyle}"
                   Height="38"
                   SelectedValue="center"
                   SelectionChanged="VideoEditorOption_Changed">
          <ComboBoxItem Content="Center" Tag="center"/>
          <ComboBoxItem Content="Single locked subject" Tag="locked"/>
          <ComboBoxItem Content="Per-scene adaptive" Tag="adaptive"/>
         </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0">
         <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/>
         <ComboBox x:Name="VideoEditorAspectComboBox"
                   SelectedValuePath="Tag"
                   Style="{DynamicResource SettingsComboBoxStyle}"
                   Height="38"
                   SelectedValue="1:1"
                   SelectionChanged="VideoEditorOption_Changed">
          <ComboBoxItem Content="Square 1:1" Tag="1:1"/>
          <ComboBoxItem Content="Widescreen 16:9" Tag="16:9"/>
          <ComboBoxItem Content="Classic 4:3" Tag="4:3"/>
          <ComboBoxItem Content="Original" Tag="original"/>
         </ComboBox>
        </StackPanel>
      </Grid>

      <TabControl Grid.Row="1" Style="{DynamicResource SettingsTabControlStyle}" Margin="0,0,0,8">
        <TabItem Header="CRT" Width="76" MinWidth="64" Style="{DynamicResource SettingsTabItemStyle}">
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10,10,10,12">
           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="CRT Tone" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorCrtCheckBox" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Subtle contrast and color shaping for a CRT-style image." Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
           </Border>

           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Scanlines" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorScanlinesCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Real horizontal scanlines are rendered into the video." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8"/>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Darkness" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorScanlineSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="100" Value="25" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorScanlineValue" Grid.Column="2" Text="25%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>

           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Vignette" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorVignetteCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Strength" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorVignetteSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="100" Value="5" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorVignetteValue" Grid.Column="2" Text="5%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>

        <TabItem Header="VHS" Width="76" MinWidth="64" Style="{DynamicResource SettingsTabItemStyle}">
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10,10,10,12">
           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Chroma Bleed" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorChromaCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Horizontal chroma displacement for VHS color bleed." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8"/>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Shift" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorChromaSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="12" Value="4" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorChromaValue" Grid.Column="2" Text="4px" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>

           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Tape Tear" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorTearCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Animated horizontal tracking displacement, not TV snow." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8"/>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Amount" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorTearSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="100" Value="10" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorTearValue" Grid.Column="2" Text="10%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>

           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Flicker" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorFlickerCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Frame-to-frame brightness instability." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8"/>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Intensity" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorFlickerSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="100" Value="15" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorFlickerValue" Grid.Column="2" Text="15%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>

           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Tape Noise" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorTapeNoiseCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Animated analog tape grain/noise." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8"/>
             <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Amount" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorTapeNoiseSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="100" Value="12" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorTapeNoiseValue" Grid.Column="2" Text="12%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>

        <TabItem Header="Glitch" Width="84" MinWidth="72" Style="{DynamicResource SettingsTabItemStyle}">
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10,10,10,12">
           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="RGB Split" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorRgbSplitCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Real red/blue channel separation." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8"/>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Offset" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorRgbSplitSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="20" Value="4" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorRgbSplitValue" Grid.Column="2" Text="4px" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>

           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Horizontal Glitch" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorGlitchCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Animated horizontal image displacement bands." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8"/>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Amount" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorGlitchSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="100" Value="12" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorGlitchValue" Grid.Column="2" Text="12%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>

        <TabItem Header="Color" Width="80" MinWidth="68" Style="{DynamicResource SettingsTabItemStyle}">
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10,10,10,12">
           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Hue / Colour Drift" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorHueCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Degrees" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorHueSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="-180" Maximum="180" Value="0" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorHueValue" Grid.Column="2" Text="0°" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>

           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Saturation" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorSaturationCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Amount" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorSaturationSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0" Maximum="200" Value="100" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorSaturationValue" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>

           <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Contrast" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorContrastCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
              <TextBlock Text="Amount" VerticalAlignment="Center"/>
              <Slider x:Name="VideoEditorContrastSlider" Grid.Column="1" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="50" Maximum="150" Value="100" TickFrequency="1" ValueChanged="VideoEditorSlider_Changed"/>
              <TextBlock x:Name="VideoEditorContrastValue" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
             </Grid>
            </StackPanel>
           </Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>

        <TabItem Header="Custom" Width="88" MinWidth="74" Style="{DynamicResource SettingsTabItemStyle}">
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10,10,10,12">
           <Border Padding="12" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
             <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="frei0r Effect" FontWeight="SemiBold"/>
              <CheckBox x:Name="VideoEditorFrei0rCheck" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="VideoEditorOption_Changed" Unchecked="VideoEditorOption_Changed"/>
             </Grid>
             <TextBlock Text="Uses an installed frei0r FFmpeg plugin. Plugin availability depends on the FFmpeg/frei0r installation." Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,8"/>
             <ComboBox x:Name="VideoEditorFrei0rComboBox" IsEditable="False" Style="{DynamicResource SettingsComboBoxStyle}" Height="38" SelectionChanged="VideoEditorOption_Changed">
              <ComboBoxItem Content="glitch0r"/>
              <ComboBoxItem Content="scanline0r"/>
              <ComboBoxItem Content="oldfilm"/>
              <ComboBoxItem Content="nosync0r"/>
              <ComboBoxItem Content="vertigo"/>
              <ComboBoxItem Content="softglow"/>
              <ComboBoxItem Content="pixeliz0r"/>
             </ComboBox>
             <TextBox x:Name="VideoEditorFrei0rParameters" TextChanged="VideoEditorOption_Changed" Margin="0,8,0,0" Height="38" Padding="10,7" Text="" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
             <TextBlock Text="Parameters (optional, frei0r order)" Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,0"/>
            </StackPanel>
           </Border>
          </StackPanel>
         </ScrollViewer>
        </TabItem>
       </TabControl>
      </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>

 <Grid x:Name="AssetWorkshopGrid" Grid.Row="2" Grid.Column="1" Visibility="Collapsed">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="10"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <TextBlock Grid.Row="0" Text="Asset Workshop" FontSize="24" FontWeight="SemiBold"
              Foreground="{DynamicResource ForegroundBrush}" Margin="4,0,0,0"/>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="220"/>
     <ColumnDefinition Width="12"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="10">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="AssetWorkshopCategoryList">
       <Button Tag="Texture" Content="Textures" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
