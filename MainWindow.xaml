       </StackPanel>
      </Border>

     </StackPanel>
    </Border>
   </StackPanel>
  </Border>

  <Border Grid.Column="0" x:Name="SourceCard" Style="{DynamicResource CardStyle}">
   <StackPanel>
    <TextBlock x:Name="SourceLabel" Text="SOURCE SAVE" FontWeight="SemiBold"/>
