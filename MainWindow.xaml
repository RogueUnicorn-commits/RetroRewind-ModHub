       <TextBlock Grid.Row="2" Text="Platform" Foreground="{DynamicResource SecondaryBrush}" Margin="0,7,0,0"/>
       <TextBlock Grid.Row="2" Grid.Column="1" Text="Windows x64 • .NET 10 • WPF" Foreground="{DynamicResource ForegroundBrush}" Margin="0,7,0,0"/>
      </Grid>
      <TextBlock Text="Third-party tools and libraries remain separate from the main ModHub executable where required by the project architecture."
                 TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,14,0,0"/>
     </StackPanel>
