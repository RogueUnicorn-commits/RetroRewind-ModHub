               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
    <TextBlock Text="Retro Rewind ModHub is a Windows desktop toolkit for managing, installing, inspecting and working with Retro Rewind mods and game assets."
               FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,18"/>

    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="WHAT IT DOES" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>
      <TextBlock Text="• Manage installed PAK and UE4SS mods and their load order.&#10;• Download and install supported mods and required files.&#10;• Browse, preview and extract cooked Unreal assets.&#10;• Work with save transfers, blueprints and save-health tools.&#10;• Manage videos, video conversion and related media workflows.&#10;• Merge selected PAK content into a single mod package."
                 TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryBrush}"/>
     </StackPanel>
    </Border>

    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="EXTERNAL TOOLS" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
      <TextBlock Text="repak" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
      <TextBlock Text="External PAK command-line tool used for relevant PAK materialization, extraction and packaging workflows." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,0,9"/>
      <TextBlock Text="Retro Rewind: ModHub - Texture Injector" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
      <TextBlock Text="A custom texture injector made specifically for Retro Rewind ModHub. It is packaged and distributed with ModHub and is used by the texture workflow to export and replace supported game textures." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,0,9"/>
      <TextBlock Text="binkadec" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
      <TextBlock Text="Optional external BINKA audio decoder used by the cooked audio workflow when installed." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryBrush}"/>
     </StackPanel>
    </Border>

    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="LIBRARIES &amp; RUNTIMES" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
      <TextBlock Text="UAssetAPI — Unreal package/object identification.&#10;CUE4Parse — Unreal asset/package access and conversion support.&#10;Unpaker — PAK access and extraction support.&#10;LibVLC — video playback.&#10;FFmpeg — final video conversion.&#10;WebView2 — web-based UI/integration components."
                 TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="{DynamicResource SecondaryBrush}"/>
     </StackPanel>
    </Border>

    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16">
     <StackPanel>
      <TextBlock Text="PROJECT INFORMATION" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Application" Foreground="{DynamicResource SecondaryBrush}"/>
       <TextBlock Grid.Column="1" Text="Retro Rewind ModHub" Foreground="{DynamicResource ForegroundBrush}"/>
       <TextBlock Grid.Row="1" Text="Version" Foreground="{DynamicResource SecondaryBrush}" Margin="0,7,0,0"/>
