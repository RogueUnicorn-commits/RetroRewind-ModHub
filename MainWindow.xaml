<Window WindowState="Maximized" x:Class="RogueUnicorn.StoreTransfer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Retro Rewind ModHub" Width="1000" Height="720" MinWidth="850" MinHeight="600" UseLayoutRounding="True" SnapsToDevicePixels="True"
 WindowStartupLocation="CenterScreen" Icon="/RetroRewindModhub;component/Assets/RRShopTransfer_60sMod.png" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
        <SolidColorBrush x:Key="CoreUiBackgroundBrush" Color="#0A0E17"/>
        <SolidColorBrush x:Key="CoreUiSurfaceBrush" Color="#0F1D26"/>
        <SolidColorBrush x:Key="CoreUiPanelBrush" Color="#111F28"/>
        <SolidColorBrush x:Key="CoreUiInnerBrush" Color="#14212A"/>
        <SolidColorBrush x:Key="CoreUiHoverBrush" Color="#1A262E"/>
        <SolidColorBrush x:Key="CoreUiBorderBrush" Color="#263030"/>
        <SolidColorBrush x:Key="CoreUiAccentBrush" Color="#125F6F"/>
        <SolidColorBrush x:Key="CoreUiAccentBrightBrush" Color="#146272"/>
        <SolidColorBrush x:Key="CoreUiTitleBrush" Color="#FEE1B5"/>
        <SolidColorBrush x:Key="CoreUiTextBrush" Color="#FEDDAA"/>
        <SolidColorBrush x:Key="CoreUiLabelBrush" Color="#415151"/>
        <SolidColorBrush x:Key="SidebarIconBrush" Color="#FEE1B5"/>
        <SolidColorBrush x:Key="CoreUiMutedBrush" Color="#FED18B"/>
        <SolidColorBrush x:Key="CoreUiDarkBrush" Color="#0A0E17"/>
        <SolidColorBrush x:Key="CoreUiRedBrush" Color="#FF1230"/>
        <SolidColorBrush x:Key="CoreUiDeepRedBrush" Color="#C90020"/>
