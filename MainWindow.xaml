       <Button Tag="Material" Content="Materials" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
       <Button Tag="Animation" Content="Animations" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
       <Button Tag="Audio" Content="Audio" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
       <Button Tag="Blueprint" Content="Blueprints" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
       <Button Tag="Niagara" Content="Niagara" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
       <Button Tag="Particle" Content="Particles" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
       <Button Tag="Widget" Content="Widgets" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
       <Button Tag="World" Content="Worlds" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
       <Button Tag="Other" Content="Other" Style="{DynamicResource BrowseButtonStyle}" Padding="12,9" Margin="0,2" HorizontalContentAlignment="Left" Click="AssetWorkshopCategory_Click" MouseEnter="AssetWorkshopCategory_MouseEnter"/>
      </StackPanel>
     </ScrollViewer>
    </Border>

    <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="20">
     <TextBlock x:Name="AssetWorkshopCategoryDescription"
               Text="Select an Asset Workshop category to see what you can do with it."
               TextWrapping="Wrap"
               VerticalAlignment="Top"
               Foreground="{DynamicResource ForegroundBrush}"
               FontSize="15"
               LineHeight="24"
               Padding="12"/>
    </Border>
   </Grid>
  </Grid>
 </Grid>

<Grid x:Name="AssetWorkshopLegacyTextureGrid" Grid.Row="2" Grid.Column="1" Visibility="Collapsed">
  
    
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- Left: search, filters and logical asset list -->
   <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock x:Name="AssetWorkshopLegacyPageTitle" Text="Textures" FontWeight="SemiBold" FontSize="20"/>
       <TextBlock x:Name="AssetWorkshopLegacyPageSubtitle" Text="Vanilla game assets" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryBrush}"/>
      </StackPanel>
       <Button Grid.Column="1" Tag="assets" Click="Mode_Click" Padding="8,6" Style="{DynamicResource BrowseButtonStyle}" ToolTip="Back to Asset Workshop" AutomationProperties.Name="Back to Asset Workshop"><Image Source="/RetroRewindModhub;component/Assets/AssetWorkshopBack.png" Width="24" Height="24" Stretch="Uniform"/></Button>

     </Grid>
     <StackPanel Grid.Row="1" Margin="0,14,0,10">
      <Grid Height="34">
       <TextBox x:Name="AssetWorkshopLegacySearchBox" Height="34" VerticalContentAlignment="Center"
                TextChanged="AssetWorkshopSearchBox_TextChanged"
                Padding="10,6"
                Foreground="{DynamicResource ForegroundBrush}" CaretBrush="{DynamicResource ForegroundBrush}"
                SelectionBrush="{DynamicResource AccentBrush}" SelectionTextBrush="{DynamicResource AccentForegroundBrush}"
                Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" ToolTip="Search asset names"/>
       <TextBlock Text="Search assets…" Margin="12,0,12,0" VerticalAlignment="Center"
                  Foreground="{DynamicResource SecondaryBrush}" IsHitTestVisible="False">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding Text, ElementName=AssetWorkshopSearchBox}" Value="">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
      </Grid>
</StackPanel>
     <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="ASSETS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}"/>
       <TextBlock x:Name="AssetWorkshopLegacyEntryCount" Grid.Column="1" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/>
      </Grid>
      <ListBox x:Name="AssetWorkshopLegacyEntriesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
               SelectionChanged="AssetWorkshopEntriesList_SelectionChanged"
               ItemContainerStyle="{DynamicResource ModListBoxItemStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.CanContentScroll="True"
               ScrollViewer.PanningMode="VerticalOnly"
               VirtualizingPanel.ScrollUnit="Pixel"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"/>
     </Grid>
     <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <StackPanel Grid.Column="1" Orientation="Horizontal"><ToggleButton x:Name="AssetWorkshopLegacyBuildModeToggle"
                  Content="Build Mode"
                  Margin="0,0,8,0"
                  Padding="12,6"
                  IsEnabled="False"
                  Checked="AssetWorkshopBuildModeToggle_Changed"
                  Unchecked="AssetWorkshopBuildModeToggle_Changed"
                  Style="{DynamicResource AssetWorkshopBuildToggleStyle}"/>
      <Button x:Name="AssetWorkshopLegacyExtractButton" Content="Extract Asset" Padding="14,7" Style="{DynamicResource AccentButtonStyle}" Click="AssetWorkshopExtractButton_Click" IsEnabled="False"/>
      <Button x:Name="AssetWorkshopLegacyBuildPakButton" Content="Build PAK" Padding="14,7" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="AssetWorkshopBuildPakButton_Click" IsEnabled="False" Visibility="Collapsed"/></StackPanel>
      <TextBlock x:Name="AssetWorkshopLegacyStatus" Text="Scanning RetroRewind-Windows.pak…" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- Right: preview and information -->
   <Border x:Name="AssetWorkshopLegacyBuildPreviewPanel" Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="12" Visibility="Collapsed">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="Original" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="Replacement" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      </Grid>

      <Grid Grid.Row="1">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>

       <Border x:Name="AssetWorkshopOriginalBuildPanel" Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="8">
        <Grid>
         <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <Image Grid.Row="0" x:Name="AssetWorkshopLegacyOriginalBuildImage" Stretch="Uniform"/>
         <TextBlock Grid.Row="1" x:Name="AssetWorkshopLegacyOriginalBuildInfo"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource SecondaryBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>
        </Grid>
       </Border>

       <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="8">
        <Grid>
         <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <Image Grid.Row="0" x:Name="AssetWorkshopLegacyReplacementBuildImage" Stretch="Uniform"/>
         <TextBlock Grid.Row="1" x:Name="AssetWorkshopLegacyReplacementBuildInfo"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource SecondaryBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>
        </Grid>
       </Border>
      </Grid>
     </Grid>
    </Border>

    <Border x:Name="AssetWorkshopLegacyStandardTexturePreviewPanel" Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="ASSET PREVIEW" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}"/>
      <TextBlock x:Name="AssetWorkshopLegacyPreviewName" Text="Select an asset" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Border Grid.Row="1" Margin="0,16,0,16" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
      <Grid>
       <Image x:Name="AssetWorkshopLegacyPreviewImage" Visibility="Collapsed" Stretch="Uniform" Margin="18" SnapsToDevicePixels="True"/>
       <TextBlock x:Name="AssetWorkshopLegacyPreviewStatus" Text="Choose an asset from the list to view its information." Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="30"/>
       <StackPanel x:Name="AssetWorkshopLegacyAudioControls" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="18" Background="{DynamicResource InputBackgroundBrush}">
        <Grid Margin="8,8,8,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button Content="▶ / ❚❚" Padding="10,5" Style="{DynamicResource AccentButtonStyle}" Click="AssetWorkshopAudioPlay_Click"/>
         <Slider x:Name="AssetWorkshopLegacyAudioProgress" Grid.Column="1" Minimum="0" Maximum="1" Margin="10,0" VerticalAlignment="Center" PreviewMouseUp="AssetWorkshopAudioProgress_PreviewMouseUp"/>
         <Button Grid.Column="2" Content="■" Padding="10,5" Style="{DynamicResource BrowseButtonStyle}" Click="AssetWorkshopAudioStop_Click"/>
        </Grid>
        <Grid Margin="8,0,8,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
         <TextBlock x:Name="AssetWorkshopLegacyAudioTime" Text="0:00" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="2" Text="Volume" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="12,0,8,0"/>
         <Slider x:Name="AssetWorkshopLegacyAudioVolume" Grid.Column="3" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="AssetWorkshopAudioVolume_ValueChanged"/>
        </Grid>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Type" Foreground="{DynamicResource SecondaryBrush}"/>
      <TextBlock x:Name="AssetWorkshopLegacyPreviewType" Grid.Column="1" Foreground="{DynamicResource ForegroundBrush}"/>
      <TextBlock Text="Size" Grid.Row="1" Foreground="{DynamicResource SecondaryBrush}" Margin="0,6,0,0"/>
      <TextBlock x:Name="AssetWorkshopLegacyPreviewSize" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0"/>
      <TextBlock Text="Asset Path" Grid.Row="2" Foreground="{DynamicResource SecondaryBrush}" Margin="0,6,0,0"/>
      <TextBlock x:Name="AssetWorkshopLegacyPreviewPath" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTipService.ShowOnDisabled="True"/>
      <TextBlock Text="Source Class" Grid.Row="3" Foreground="{DynamicResource SecondaryBrush}" Margin="0,6,0,0"/>
      <TextBlock x:Name="AssetWorkshopLegacyPreviewSourceClass" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="Package Files" Grid.Row="4" Foreground="{DynamicResource SecondaryBrush}" Margin="0,6,0,0"/>
      <TextBlock x:Name="AssetWorkshopLegacyPreviewFiles" Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0"/>
      <TextBlock Text="3D Preview" Grid.Row="5" Foreground="{DynamicResource SecondaryBrush}" Margin="0,6,0,0"/>
      <TextBlock x:Name="AssetWorkshopLegacyPreviewMeshPreview" Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>

<Grid x:Name="AssetWorkshopTexturePageGrid" Grid.Row="2" Grid.Column="1" Visibility="Collapsed">
  
    
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- Left: search, filters and logical asset list -->
   <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock x:Name="AssetWorkshopTexturePageTitle" Text="Textures" FontWeight="SemiBold" FontSize="20"/>
       <TextBlock x:Name="AssetWorkshopTexturePageSubtitle" Text="Vanilla game assets" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryBrush}"/>
