       <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,4"><TextBlock Text="Money" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorMoney" Text="—"/></StackPanel>

       <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,4"><TextBlock Text="Game date" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorGameDate" Text="—"/></StackPanel>
       <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,4"><TextBlock Text="Game day" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorGameDay" Text="—"/></StackPanel>
       <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,4"><TextBlock Text="Days passed" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorDaysPassed" Text="—"/></StackPanel>

       <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,4"><TextBlock Text="Last saved / played" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorLastPlayed" Text="—"/></StackPanel>
       <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,12,4"><TextBlock Text="Global footsteps" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorGlobalFootsteps" Text="—"/></StackPanel>
       <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,4"><TextBlock Text="Global clients served" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorGlobalClientsServed" Text="—"/></StackPanel>

       <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,4"><TextBlock Text="Daily movie returns" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorDailyMovieReturns" Text="—"/></StackPanel>
       <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,12,4"><TextBlock Text="Daily XP" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorDailyXP" Text="—"/></StackPanel>
       <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,4"><TextBlock Text="Daily staff spending" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="InspectorDailyStaffSpending" Text="—"/></StackPanel>
       <!-- Store Upgrade(s) and Unlocked Rooms are shown in the full-width Store section below. -->
      </Grid>
     </StackPanel>
    </Border>
    <Border Margin="0,10,0,0" Padding="12"
            Background="{DynamicResource SecondaryCardBrush}" CornerRadius="8">
     <StackPanel>
      <TextBlock Text="STORE" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <StackPanel Margin="0,0,0,6">
       <TextBlock Text="Store Upgrade(s)" Foreground="{DynamicResource SecondaryBrush}"/>
       <TextBlock x:Name="InspectorStoreUpgrades" Text="—" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <StackPanel>
       <TextBlock Text="Unlocked Rooms" Foreground="{DynamicResource SecondaryBrush}"/>
       <TextBlock x:Name="InspectorUnlockedRooms" Text="—" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
      </StackPanel>
     </StackPanel>
    </Border>
     <Border Margin="0,10,0,0" Padding="10"
             Background="{DynamicResource SecondaryCardBrush}"
             CornerRadius="6">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="190"/>
       </Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="SAVE HEALTH CHECK" FontWeight="SemiBold"/>
        <TextBlock x:Name="InspectorHealthStatus" Text="No active save selected."
                   Margin="0,2,0,0"
                   Foreground="{DynamicResource SecondaryBrush}"
                   TextWrapping="Wrap"/>
       </StackPanel>
       <Button x:Name="InspectorHealthCheckButton"
               Grid.Column="1"
               Content="Run Health Check"
               Width="175"
               Height="36"
               HorizontalAlignment="Right"
               Click="InspectorHealthCheck_Click"
               Style="{DynamicResource AccentButtonStyle}"
               IsEnabled="False"/>
      </Grid>
     </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Border>

  <Border Grid.Column="2" MinWidth="0" HorizontalAlignment="Stretch" Style="{DynamicResource CardStyle}">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="ALL OBJECTS" FontWeight="SemiBold"/>
      <TextBlock x:Name="InspectorObjectCount" Text="—" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
     <Button x:Name="ObjectsDecorationsButton" Content="Decorations" Tag="Decorations"
             Click="ObjectGroup_Click" Style="{DynamicResource TabButtonStyle}"/>
     <Button x:Name="ObjectsEquipmentButton" Content="Equipment" Tag="Equipment"
             Click="ObjectGroup_Click" Style="{DynamicResource TabButtonStyle}"/>
     <Button x:Name="ObjectsShelvesButton" Content="Shelves" Tag="Shelves"
             Click="ObjectGroup_Click" Style="{DynamicResource TabButtonStyle}"/>
     <Button x:Name="ObjectsExcludedButton" Content="Excluded" Tag="Excluded"
             Click="ObjectGroup_Click" Style="{DynamicResource TabButtonStyle}"/>
    </StackPanel>
    <ListView x:Name="ObjectList" MinWidth="0" HorizontalContentAlignment="Stretch" Grid.Row="2" Background="{DynamicResource InputBackgroundBrush}"
              Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
              ItemContainerStyle="{DynamicResource ObjectListItemStyle}"
              SizeChanged="ObjectList_SizeChanged"
              PreviewMouseLeftButtonDown="ObjectList_PreviewMouseDown"
              PreviewMouseRightButtonDown="ObjectList_PreviewMouseDown"
              SelectionMode="Single"
              Focusable="False"
              IsHitTestVisible="True"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListView.View>
      <GridView ColumnHeaderContainerStyle="{DynamicResource ObjectGridHeaderStyle}">
       <GridViewColumn x:Name="ObjectColumn" Header="Object" Width="220">
        <GridViewColumn.CellTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Class}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
         </DataTemplate>
        </GridViewColumn.CellTemplate>
       </GridViewColumn>
       <GridViewColumn x:Name="CountColumn" Header="Count" Width="70">
        <GridViewColumn.HeaderTemplate>
         <DataTemplate>
          <TextBlock Text="Count" HorizontalAlignment="Center" TextAlignment="Center"/>
         </DataTemplate>
        </GridViewColumn.HeaderTemplate>
        <GridViewColumn.CellTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Count}" HorizontalAlignment="Center"
                     TextAlignment="Center" VerticalAlignment="Center"/>
         </DataTemplate>
        </GridViewColumn.CellTemplate>
       </GridViewColumn>
      </GridView>
     </ListView.View>
    </ListView>
   </Grid>
  </Border>
 </Grid>

 <Grid x:Name="OptionsPanel" Grid.Row="3" Grid.Column="1" Margin="0,18,0,0">
  <StackPanel>
   <TextBlock Text="TRANSFER OPTIONS" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal">
    <CheckBox x:Name="TransferFurnitureBox" Content="Transfer Furniture" IsChecked="True"
              Margin="0,0,28,0" Style="{DynamicResource TransferToggleStyle}" Checked="OperationToggle_Changed" Unchecked="OperationToggle_Changed"/>
    <CheckBox x:Name="TransferStoreStyleBox" Content="Transfer Shop Style" IsChecked="True"
              Margin="0,0,28,0" Style="{DynamicResource TransferToggleStyle}" Checked="OperationToggle_Changed" Unchecked="OperationToggle_Changed"/>
   </StackPanel>
  </StackPanel>
 </Grid>

 <Grid x:Name="ImportOptionsPanel" Grid.Row="3" Grid.Column="1" Margin="0,18,0,0" Visibility="Collapsed">
  <StackPanel>
   <TextBlock Text="IMPORT OPTIONS" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal">
    <CheckBox x:Name="ImportFurnitureBox" Content="Import Furniture" IsChecked="True"
              Margin="0,0,28,0" Style="{DynamicResource TransferToggleStyle}" Checked="OperationToggle_Changed" Unchecked="OperationToggle_Changed"/>
    <CheckBox x:Name="ImportStoreStyleBox" Content="Import Shop Style" IsChecked="True"
              Margin="0,0,28,0" Style="{DynamicResource TransferToggleStyle}" Checked="OperationToggle_Changed" Unchecked="OperationToggle_Changed"/>
   </StackPanel>
  </StackPanel>
 </Grid>

 <Grid x:Name="HealthGrid" Grid.Row="2" Grid.Column="1" Visibility="Collapsed">
  <Border Style="{DynamicResource CardStyle}">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="210"/>
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="SAVE HEALTH CHECK" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Validate every .sav file without modifying any save."
                 Margin="0,4,0,0" Foreground="{DynamicResource SecondaryBrush}"/>
     </StackPanel>
     <Button x:Name="HealthRunButton" Grid.Column="1" Content="Run Health Check"
             Width="190" Height="40" HorizontalAlignment="Right"
             Click="HealthRun_Click"
             Style="{DynamicResource AccentButtonStyle}"/>
    </Grid>

    <Border Grid.Row="1" Margin="0,16,0,0"
            Background="{DynamicResource SecondaryCardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="44"/>
       <ColumnDefinition Width="4*"/>
       <ColumnDefinition Width="2.2*"/>
       <ColumnDefinition Width="90"/>
       <ColumnDefinition Width="1.8*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="✓" FontSize="16" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,8"/>
      <TextBlock Grid.Column="1" Text="Save File" FontWeight="SemiBold"
                 Margin="8,8"/>
      <TextBlock Grid.Column="2" Text="Save Name" FontWeight="SemiBold"
                 Margin="8,8"/>
      <TextBlock Grid.Column="3" Text="Object(s)" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Margin="8,8"/>
      <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold"
                 Margin="8,8"/>
     </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" Margin="0,6,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="HealthResultsPanel"/>
    </ScrollViewer>
   </Grid>
  </Border>
 </Grid>

 <Grid x:Name="ActionPanel" Grid.Row="1" Grid.Column="1"
       Visibility="Collapsed">
  <Button x:Name="ActionButton" Content="Action" Click="Action_Click"/>
 </Grid>

 <Border Grid.Row="4" Grid.Column="1" Margin="0,18,0,0" Padding="0,12,0,0"
         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <Grid Grid.Column="0" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
     <StackPanel x:Name="PosterBrowserInvalidTogglePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="18,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="Show invalid and unused images" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ToggleButton x:Name="PosterBrowserInvalidToggle" Height="28" Padding="10,0" Style="{DynamicResource MergeAssetToggleStyle}" Click="PosterBrowserInvalidToggle_Click" ToolTip="Show invalid and unused images">
       <TextBlock Text="Show" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
      </ToggleButton>
     </StackPanel>
     <CheckBox x:Name="DownloadsHiddenToggle" Content="Hidden Files" Visibility="Collapsed"
              Foreground="{DynamicResource AccentBrush}" Background="Transparent"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              Style="{DynamicResource TransferToggleStyle}"
              Checked="DownloadsHiddenToggle_Click" Unchecked="DownloadsHiddenToggle_Click"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Column="1"
               HorizontalAlignment="Right"
               VerticalAlignment="Center">
    <TextBlock x:Name="ProductVersionFooterText"
               Text=""
               HorizontalAlignment="Right"
               TextAlignment="Right"
               Foreground="{DynamicResource SecondaryBrush}"
               FontSize="11"/>
    <TextBlock x:Name="AdminModeFooterText"
               Text="Admin: Off (Using Copy Mode)"
               HorizontalAlignment="Right"
               TextAlignment="Right"
               Foreground="{DynamicResource SecondaryBrush}"
               FontSize="11"
               Margin="0,2,0,0"/>
   </StackPanel>
  </Grid>
 </Border>

  <!-- Hidden compatibility controls used by the mode/engine code. -->
  <Border x:Name="OptionsCard" Visibility="Collapsed" Width="0" Height="0"/>
  <TextBox x:Name="BlueprintBox" Visibility="Collapsed" Width="0" Height="0"/>
  <TextBlock x:Name="BlueprintInfo" Visibility="Collapsed" Width="0" Height="0"/>
  <ProgressBar x:Name="Progress" Visibility="Collapsed" Width="0" Height="0"/>
 </Grid>
  <Grid x:Name="SlidePanelOverlay"
        Grid.Row="0" Grid.RowSpan="2"
        Grid.Column="0" Grid.ColumnSpan="1"
        Panel.ZIndex="1000"
        Background="Transparent"
        IsHitTestVisible="True"
        Visibility="Collapsed">
   <Border x:Name="SlidePanelBackdrop"
           Background="#99000000"
           BorderThickness="0"
           Focusable="False"
           MouseLeftButtonDown="SlidePanelBackdrop_Click"/>

   <Border x:Name="SlidePanelSurface"
           Panel.ZIndex="1001"
           IsHitTestVisible="True"
           Focusable="True"
           HorizontalAlignment="Center"
           VerticalAlignment="Stretch"
           Background="{DynamicResource CardBrush}"
           BorderBrush="{DynamicResource AccentBrush}"
           BorderThickness="0,0,0,2"
           SnapsToDevicePixels="True"
           ClipToBounds="True">
    <ContentControl x:Name="SlidePanelHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Foreground="{DynamicResource ForegroundBrush}"
                    BorderThickness="0"/>
   </Border>
  </Grid>

  <Grid x:Name="OperationOverlay"
        Grid.Row="0" Grid.RowSpan="3"
        Grid.Column="0" Grid.ColumnSpan="1"
        Panel.ZIndex="999"
        Visibility="Collapsed"
        Margin="-30"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#88000000">
   <Border Width="430" Padding="24"
           HorizontalAlignment="Center" VerticalAlignment="Center"
           Background="{DynamicResource CardBrush}"
           BorderBrush="{DynamicResource BorderBrush}"
           BorderThickness="1" CornerRadius="14">
    <StackPanel>
     <TextBlock Text="Working…" FontSize="20" FontWeight="SemiBold"
                HorizontalAlignment="Center"/>
     <TextBlock x:Name="OperationOverlayStatus" Text="Preparing…"
                Margin="0,8,0,2" HorizontalAlignment="Center"
                TextAlignment="Center" TextWrapping="Wrap"
                Foreground="{DynamicResource SecondaryBrush}"/>
     <TextBlock x:Name="OperationOverlayDetail" Text=""
                Margin="0,0,0,14" HorizontalAlignment="Center"
                TextAlignment="Center" TextWrapping="Wrap"
                Foreground="{DynamicResource ForegroundBrush}"/>
     <ProgressBar x:Name="OperationOverlayProgress" IsIndeterminate="True" Height="8" Width="340"
                  Minimum="0" Maximum="100" Value="0"
                  HorizontalAlignment="Center"/>
     <TextBlock Text="Please wait…" Margin="0,10,0,0"
                HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/>
     <Button x:Name="PosterBrowserOperationCancelButton" Content="Cancel" Margin="0,12,0,0"
             Padding="18,7" HorizontalAlignment="Center" Style="{DynamicResource BrowseButtonStyle}"
             Click="PosterBrowserOperationCancel_Click" Visibility="Collapsed"/>
    </StackPanel>
   </Border>
  </Grid>





<Grid x:Name="AssetWorkshopBuildPakDialogOverlay"
          Grid.Row="1"
          Panel.ZIndex="5000"
          Visibility="Collapsed"
          Background="#80000000"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border Width="520"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Name Your Mod"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBox x:Name="AssetWorkshopBuildPakModNameTextBox"
                         Margin="0,16,0,14"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Padding="10,7"
                         TextChanged="AssetWorkshopBuildPakModNameTextBox_TextChanged"/>
                <CheckBox x:Name="AssetWorkshopPackForNexusToggle"
                          Content="Pack mod for Nexus"
                          IsChecked="False"
                          Foreground="{DynamicResource ForegroundBrush}"
                          Margin="0,0,0,22"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Padding="18,8"
                            Margin="0,0,8,0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Click="AssetWorkshopBuildPakCancel_Click"/>
                    <Button x:Name="AssetWorkshopBuildPakConfirmButton"
                            Content="Build PAK"
                            Padding="18,8"
                            Style="{DynamicResource AccentButtonStyle}"
                            IsEnabled="False"
                            Click="AssetWorkshopBuildPakConfirm_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    
    <Grid x:Name="PosterBrowserFullscreenPreviewOverlay"
          Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="1"
          Panel.ZIndex="10000"
          Visibility="Collapsed"
          Opacity="0"
          Background="Black"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          IsHitTestVisible="True"
          Focusable="True"
          MouseLeftButtonDown="PosterBrowserFullscreenPreviewOverlay_MouseLeftButtonDown">
      <Image x:Name="PosterBrowserFullscreenPreviewImage"
             Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             IsHitTestVisible="False"/>
    </Grid>
</Grid>
</Window>
