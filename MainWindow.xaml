      <Button x:Name="RequiredYtDlpButton" Grid.Column="1" Content="Download" Width="120" Height="34" Margin="18,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="RequiredYtDlpButton_Click"/>
