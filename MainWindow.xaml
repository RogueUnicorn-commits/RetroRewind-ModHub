     <Border Grid.Column="0" Height="300" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
      <Image x:Name="PosterBrowserSelectedPreview" Stretch="Uniform" MouseLeftButtonDown="PosterBrowserSelectedPreview_MouseLeftButtonDown" Cursor="Hand"/>
     </Border>
     <Grid Grid.Column="1" Margin="16,0,16,0">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="PosterBrowserSelectedFileName" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <TextBlock x:Name="PosterBrowserSelectedPath" Grid.Row="1" Margin="0,4,0,2" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <TextBlock x:Name="PosterBrowserSelectedRelative" Grid.Row="2" Margin="0,0,0,7" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <Grid Grid.Row="3" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Type" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="PosterBrowserSelectedType" Grid.Column="1"/></Grid>
      <Grid Grid.Row="4" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="File size" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="PosterBrowserSelectedSize" Grid.Column="1"/></Grid>
      <Grid Grid.Row="5" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Dimensions" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="PosterBrowserSelectedDimensions" Grid.Column="1"/></Grid>
      <Grid Grid.Row="6" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Aspect ratio" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="PosterBrowserSelectedAspect" Grid.Column="1"/></Grid>
      <Grid Grid.Row="7" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Modified" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock x:Name="PosterBrowserSelectedModified" Grid.Column="1"/></Grid>
      <Grid Grid.Row="8" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="PosterBrowserSelectedStatusIcon" Width="18" Height="18" Background="{DynamicResource AccentBrush}"/><TextBlock x:Name="PosterBrowserSelectedStatus" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0"/></Grid>
      <TextBlock x:Name="PosterBrowserSelectedReason" Grid.Row="9" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}"/>
     </Grid>
     <StackPanel Grid.Column="2" VerticalAlignment="Top">
      <Button x:Name="PosterBrowserSelectedGoToButton" Width="42" Height="42" Margin="0,0,0,8" Style="{DynamicResource ModIconButtonStyle}" Click="PosterBrowserSelectedGoTo_Click" ToolTip="Go to file in Windows Explorer">
       <Border Width="22" Height="22" Background="{DynamicResource AccentBrush}">
        <Border.OpacityMask><ImageBrush ImageSource="pack://application:,,,/RetroRewindModhub;component/Assets/VideoEditorChooseMp4.png" Stretch="Uniform"/></Border.OpacityMask>
       </Border>
      </Button>
      <Button x:Name="PosterBrowserSelectedEditButton" Width="42" Height="42" Margin="0,0,0,8" Style="{DynamicResource ModIconButtonStyle}" Click="PosterBrowserSelectedEdit_Click" ToolTip="Edit source image">
       <TextBlock Text="✎" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>
      <Button x:Name="PosterBrowserSelectedDeleteButton" Width="42" Height="42" Margin="0,0,0,8" Style="{DynamicResource ModIconButtonStyle}" Click="PosterBrowserSelectedDelete_Click" ToolTip="Delete selected image">
       <Border Width="22" Height="22" Background="{DynamicResource AccentBrush}">
        <Border.OpacityMask><ImageBrush ImageSource="pack://application:,,,/RetroRewindModhub;component/Assets/delete.png" Stretch="Uniform"/></Border.OpacityMask>
       </Border>
      </Button>
      <Button x:Name="PosterBrowserSelectedCloseButton" Width="42" Height="42" Style="{DynamicResource ModIconButtonStyle}" Content="×" FontSize="22" Click="PosterBrowserSelectedClose_Click" ToolTip="Close image details"/>
     </StackPanel>
    </Grid>
   </Border>

   <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="10">
    <ScrollViewer x:Name="PosterBrowserScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="PosterBrowserScrollViewer_ScrollChanged" Focusable="True" IsHitTestVisible="True">
     <WrapPanel x:Name="PosterBrowserItemsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>

<Grid x:Name="PosterAutoAddGrid" Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Margin="0">
