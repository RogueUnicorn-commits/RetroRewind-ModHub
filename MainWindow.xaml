<Grid x:Name="PosterImageEditorGrid" Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Margin="0">
  <Grid Margin="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="PosterImageEditorBackButton" Grid.Column="0" Width="42" Height="42" Style="{DynamicResource ModIconButtonStyle}" Click="PosterImageEditorBackButton_Click" ToolTip="Back to Poster Browser">
       <Border Width="22" Height="22" Background="{DynamicResource AccentBrush}"><Border.OpacityMask><ImageBrush ImageSource="pack://application:,,,/RetroRewindModhub;component/Assets/AssetWorkshopBack.png" Stretch="Uniform"/></Border.OpacityMask></Border>
      </Button>
      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="Image Editor" FontWeight="SemiBold" FontSize="20" Foreground="{DynamicResource ForegroundBrush}"/>
       <TextBlock x:Name="PosterImageEditorSourceName" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
     <Grid x:Name="PosterImageEditorCanvas" Grid.Row="1" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ClipToBounds="True" SizeChanged="PosterImageEditorCanvas_SizeChanged" MouseLeftButtonDown="PosterImageEditorImage_MouseLeftButtonDown" MouseMove="PosterImageEditorImage_MouseMove" MouseLeftButtonUp="PosterImageEditorImage_MouseLeftButtonUp">
      <Rectangle x:Name="PosterImageEditorTemplateBackground" Fill="Transparent" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Border x:Name="PosterImageEditorClipViewport" Width="400" Height="800" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CardBrush}" ClipToBounds="True" IsHitTestVisible="True">
       <Canvas x:Name="PosterImageEditorImageCanvas" ClipToBounds="True">
        <Image x:Name="PosterImageEditorImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
       </Canvas>
      </Border>
      <Border x:Name="PosterImageEditorFrame" Width="400" Height="800" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="10"/>
      <TextBlock x:Name="PosterImageEditorFrameLabel" Text="GAME FRAME" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" IsHitTestVisible="False" Panel.ZIndex="11"/>
     </Grid>
     <TextBlock x:Name="PosterImageEditorStatus" Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
   </Border>

   <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="Resolution" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/><ComboBox x:Name="PosterImageEditorResolutionCombo" Style="{DynamicResource SettingsComboBoxStyle}" Height="38" VerticalContentAlignment="Center"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="AI Upscale" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,5"/><ComboBox x:Name="PosterImageEditorUpscaleCombo" Style="{DynamicResource SettingsComboBoxStyle}" Height="38" VerticalContentAlignment="Center" SelectionChanged="PosterImageEditorUpscaleCombo_SelectionChanged"/></StackPanel>
     </Grid>
     <TabControl Grid.Row="1" Style="{DynamicResource SettingsTabControlStyle}" Margin="0">
      <TabItem Header="Position" Style="{DynamicResource SettingsTabItemStyle}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,10,10,12">
        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Zoom" FontWeight="SemiBold"/></Grid><TextBlock Text="Controls how far the source image is zoomed behind the frame." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Slider x:Name="PosterImageEditorZoomSlider" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="1" Maximum="4" Value="1" TickFrequency="0.1" ValueChanged="PosterImageEditorZoomSlider_ValueChanged"/></StackPanel></Border>
        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="X / Y Position" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,3,0"/><CheckBox x:Name="PosterImageEditorXEnable" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Margin="0,0,10,0" Checked="PosterImageEditorPositionEnable_Changed" Unchecked="PosterImageEditorPositionEnable_Changed" ToolTip="Enable horizontal movement"/><TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,3,0"/><CheckBox x:Name="PosterImageEditorYEnable" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="PosterImageEditorPositionEnable_Changed" Unchecked="PosterImageEditorPositionEnable_Changed" ToolTip="Enable vertical movement"/></StackPanel></Grid><TextBlock Text="Moves the source image horizontally and vertically behind the frame." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="X"/><TextBox x:Name="PosterImageEditorXTextBox" Text="0" Margin="0,4,0,0" TextChanged="PosterImageEditorPosition_TextChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y"/><TextBox x:Name="PosterImageEditorYTextBox" Text="0" Margin="0,4,0,0" TextChanged="PosterImageEditorPosition_TextChanged"/></StackPanel></Grid></StackPanel></Border>
        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Center" FontWeight="SemiBold"/></Grid><TextBlock Text="Centers the source image within the usable game frame." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Button Content="Center Image" Height="34" Style="{DynamicResource BrowseButtonStyle}" Click="PosterImageEditorCenterButton_Click"/></StackPanel></Border>
        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Fill" FontWeight="SemiBold"/></Grid><TextBlock Text="Fits the source image to cover the complete usable frame." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Button Content="Fill Frame" Height="34" Style="{DynamicResource BrowseButtonStyle}" Click="PosterImageEditorFillButton_Click"/></StackPanel></Border>
        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Flip Horizontal" FontWeight="SemiBold"/><CheckBox x:Name="PosterImageEditorFlipHorizontalEnable" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="PosterImageEditorEffectEnable_Changed" Unchecked="PosterImageEditorEffectEnable_Changed"/></Grid><TextBlock Text="Mirrors the image from left to right." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Flip Vertical" FontWeight="SemiBold"/><CheckBox x:Name="PosterImageEditorFlipVerticalEnable" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="False" Checked="PosterImageEditorEffectEnable_Changed" Unchecked="PosterImageEditorEffectEnable_Changed"/></Grid><TextBlock Text="Mirrors the image from top to bottom." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Rotate" FontWeight="SemiBold"/></Grid><TextBlock Text="Rotates the source image before it is cropped to the frame." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="Rotate Left" Height="34" Style="{DynamicResource BrowseButtonStyle}" Click="PosterImageEditorRotateLeft_Click"/><Button Grid.Column="2" Content="Rotate Right" Height="34" Style="{DynamicResource BrowseButtonStyle}" Click="PosterImageEditorRotateRight_Click"/></Grid></StackPanel></Border>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Color" Style="{DynamicResource SettingsTabItemStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,10,10,12"><Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Brightness" FontWeight="SemiBold"/><CheckBox x:Name="PosterImageEditorBrightnessEnable" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="PosterImageEditorColorEnable_Changed" Unchecked="PosterImageEditorColorEnable_Changed"/></Grid><TextBlock Text="Adjusts the overall lightness of the image." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Slider x:Name="PosterImageEditorBrightnessSlider" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="-100" Maximum="100" Value="0" ValueChanged="PosterImageEditorAdjustment_ValueChanged"/></StackPanel></Border><Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Contrast" FontWeight="SemiBold"/><CheckBox x:Name="PosterImageEditorContrastEnable" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="PosterImageEditorColorEnable_Changed" Unchecked="PosterImageEditorColorEnable_Changed"/></Grid><TextBlock Text="Controls the difference between light and dark areas." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Slider x:Name="PosterImageEditorContrastSlider" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="-100" Maximum="100" Value="0" ValueChanged="PosterImageEditorAdjustment_ValueChanged"/></StackPanel></Border><Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Saturation" FontWeight="SemiBold"/><CheckBox x:Name="PosterImageEditorSaturationEnable" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="PosterImageEditorColorEnable_Changed" Unchecked="PosterImageEditorColorEnable_Changed"/></Grid><TextBlock Text="Makes colors more vivid or more muted." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Slider x:Name="PosterImageEditorSaturationSlider" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="-100" Maximum="100" Value="0" ValueChanged="PosterImageEditorAdjustment_ValueChanged"/></StackPanel></Border><Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Gamma" FontWeight="SemiBold"/><CheckBox x:Name="PosterImageEditorGammaEnable" Grid.Column="1" Style="{DynamicResource VideoEditorToggleStyle}" IsChecked="True" Checked="PosterImageEditorColorEnable_Changed" Unchecked="PosterImageEditorColorEnable_Changed"/></Grid><TextBlock Text="Changes midtone brightness." Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/><Slider x:Name="PosterImageEditorGammaSlider" Style="{DynamicResource VideoEditorSliderStyle}" Minimum="0.5" Maximum="2" Value="1" ValueChanged="PosterImageEditorAdjustment_ValueChanged"/></StackPanel></Border><Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SecondaryCardBrush}" BorderBrush="{Dynami