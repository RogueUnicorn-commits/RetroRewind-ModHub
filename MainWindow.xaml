    <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Real-ESRGAN" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="AI image upscaling engine" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="RequiredRealEsrganStatus" Text="Checking…" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="RequiredRealEsrganProgress" Height="7" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"/></StackPanel>
      <Button x:Name="RequiredRealEsrganButton" Grid.Column="1" Content="Download" Width="120" Height="34" Margin="18,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="RequiredRealEsrganButton_Click"/>
