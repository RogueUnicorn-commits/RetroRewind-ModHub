     <Button x:Name="PosterBrowserAutoAddButton" Height="42" Margin="0,0,8,0" Padding="10,0" Style="{DynamicResource BrowseButtonStyle}" Click="PosterBrowserAutoAddButton_Click" ToolTip="Automatically add posters from a folder">
