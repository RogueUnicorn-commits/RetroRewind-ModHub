    <StackPanel Grid.Column="1"><TextBlock Text="AUTO ADD POSTERS" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/><TextBlock Text="Convert the selected source images into game-ready PNG posters." Margin="0,4,0,0" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel>
