     <TextBlock Grid.Column="6" x:Name="PosterAutoAddCountText" VerticalAlignment="Bottom" Margin="10,0,0,8" Foreground="{DynamicResource SecondaryBrush}"/>
    </Grid>
   </Border>
   <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="PosterAutoAddItemsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/></ScrollViewer>
   </Border>
  </Grid>
 </Grid>

