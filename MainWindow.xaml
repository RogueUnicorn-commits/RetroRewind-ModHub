 <Grid x:Name="HomeGrid" Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Margin="0,10,0,0">
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="0.9*"/>
    <ColumnDefinition Width="18"/>
    <ColumnDefinition Width="1.6*"/>
   </Grid.ColumnDefinitions>

   <!-- Left: account panels -->
   <Grid Grid.Column="0">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="8"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="16">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Nexus" FontSize="20" FontWeight="SemiBold"/>
      <Grid Grid.Row="1" Margin="0,12,0,0">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>

       <Grid Grid.Row="0" Grid.ColumnSpan="2">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="21"
                Background="{DynamicResource SecondaryCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                VerticalAlignment="Center">
         <Grid>
          <TextBlock x:Name="HomeNexusAvatarInitials" Text="N"
                     FontSize="17" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image x:Name="HomeNexusAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
         </Grid>
        </Border>
        <TextBlock x:Name="HomeNexusHeading" Grid.Column="1" Text="Nexus Account" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="10,0,0,0"/>
       </Grid>
       <TextBlock Grid.Row="1" Text="User ID" Margin="0,10,12,0"
                  Foreground="{DynamicResource SecondaryBrush}"/>
       <TextBlock x:Name="HomeNexusUserId" Grid.Row="1" Grid.Column="1"
                  Text="—" Margin="0,10,0,0" HorizontalAlignment="Right"/>
       <TextBlock Grid.Row="3" Text="Account" Margin="0,8,12,0"
                  Foreground="{DynamicResource SecondaryBrush}"/>
       <TextBlock x:Name="HomeNexusAccount" Grid.Row="3" Grid.Column="1"
                  Text="—" Margin="0,8,0,0" HorizontalAlignment="Right"/>
       <TextBlock Grid.Row="4" Text="Daily requests" Margin="0,8,12,0"
                  Foreground="{DynamicResource SecondaryBrush}"/>
       <TextBlock x:Name="HomeNexusDaily" Grid.Row="4" Grid.Column="1"
                  Text="—" Margin="0,8,0,0" HorizontalAlignment="Right"/>
       <TextBlock Grid.Row="5" Text="Hourly requests" Margin="0,8,12,0"
                  Foreground="{DynamicResource SecondaryBrush}"/>
       <TextBlock x:Name="HomeNexusHourly" Grid.Row="5" Grid.Column="1"
                  Text="—" Margin="0,8,0,0" HorizontalAlignment="Right"/>
      </Grid>
     </Grid>
    </Border>

    <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="16">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Steam" FontSize="20" FontWeight="SemiBold"/>
       <TextBlock x:Name="HomeSteamStatus" Grid.Column="1" Text="Not connected"
                  Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
      </Grid>

      <Grid Grid.Row="1" Margin="0,12,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Width="54" Height="54" CornerRadius="27"
               Background="{DynamicResource SecondaryCardBrush}"
               BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
               VerticalAlignment="Top">
        <Grid>
         <TextBlock x:Name="HomeSteamAvatarInitials" Text="S"
                    FontSize="22" FontWeight="SemiBold"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Image x:Name="HomeSteamAvatarImage"
                Stretch="UniformToFill"
                Visibility="Collapsed"/>
        </Grid>
       </Border>
       <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock x:Name="HomeSteamPersonaName" Text="Steam Profile"
                   FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="HomeSteamAccountName" Text="Sign in to Steam to display your profile."
                   Foreground="{DynamicResource SecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,3,0,0"/>
        <TextBlock x:Name="HomeSteamId" Text="" Foreground="{DynamicResource SecondaryBrush}"
                   FontSize="12" Margin="0,3,0,0"/>
       </StackPanel>
      </Grid>

      <UniformGrid Grid.Row="2" Columns="2" Margin="0,14,0,0">
       <Button Content="Achievements" Tag="achievements" Click="SteamHomeAction_Click"
               Style="{DynamicResource SettingsButtonStyle}" Margin="0,0,5,5" Height="32"/>
       <Button Content="Games" Tag="games" Click="SteamHomeAction_Click"
               Style="{DynamicResource SettingsButtonStyle}" Margin="5,0,0,5" Height="32"/>
       <Button Content="Guides" Tag="guides" Click="SteamHomeAction_Click"
               Style="{DynamicResource SettingsButtonStyle}" Margin="0,5,5,0" Height="32"/>
       <Button Content="Discussions" Tag="discussions" Click="SteamHomeAction_Click"
               Style="{DynamicResource SettingsButtonStyle}" Margin="5,5,0,0" Height="32"/>
      </UniformGrid>

      <UniformGrid Grid.Row="3" Columns="2" VerticalAlignment="Bottom" Margin="0,10,0,0">
       <Button Content="Community Hub" Tag="community" Click="SteamHomeAction_Click"
               Style="{DynamicResource SettingsButtonStyle}" Margin="0,0,5,0" Height="34"/>
       <Button Content="Play" Tag="play" Click="SteamHomeAction_Click"
               Style="{DynamicResource SettingsButtonStyle}" Margin="5,0,0,0" Height="34"/>
      </UniformGrid>
     </Grid>
    </Border>
   </Grid>

   <!-- Right: news feed -->
   <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="News Feed" FontSize="22" FontWeight="SemiBold"/>
       <TextBlock Text="Steam Updates" Foreground="{DynamicResource SecondaryBrush}" Margin="0,2,0,0"/>
      </StackPanel>

     </Grid>
     <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
      <StackPanel x:Name="HomeNewsPanel"/>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 

 <!-- Steam in-app views -->
